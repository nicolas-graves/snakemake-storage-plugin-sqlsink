configfile: "config/config.yaml"


include: "rules/db_publish.smk"
# include: "rules/parquet.smk"       # existing upstream Parquet generation (not in scope here)
# include: "rules/downstream.smk"    # Superset registration / equivalence audit / smoke tests


rule all:
    input:
        # Published-table objects: their existence is read from the database
        # (storage plugin), so a table dropped or restored out of band re-runs
        # stage_table + publish_tables, and a republish is a real, content-
        # bearing change downstream rules can depend on.
        storage.sqlsink(expand("published/{table}", table=TABLES)),
        expand("results/.datasets_published.{sink}", sink=SINKS) if config.get("datasets") else [],
